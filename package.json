{
  "name": "expenses-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "start": "vite preview --host",
    "lint": "eslint . --max-warnings=0",
    "test": "bun test --conditions=browser",
    "check": "bun run lint && bun run typecheck && bun run format:check",
    "dev:web": "vite dev",
    "dev:convex": "bunx convex dev",
    "dev": "bun run scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@clerk/clerk-js": "6.32.1",
    "@clerk/shared": "^4.33.0",
    "@clerk/ui": "^1.33.1",
    "@solidjs/router": "2.0.0-next.26",
    "@solidjs/web": "2.0.0-rc.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.46.0",
    "convex-helpers": "0.1.124",
    "fuse.js": "^7.5.0",
    "lucide": "1.47.0",
    "solid-js": "2.0.0-rc.9",
    "tailwind-merge": "3.7.0",
    "uqr": "^0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "5.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@solidjs/vite-plugin": "3.0.0-next.44",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "^20.19.43",
    "eslint": "10.11.0",
    "eslint-plugin-solid": "0.18.0",
    "filesystem-routing": "0.3.1",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-bundle-analyzer": "^1.3.9"
  }
}
